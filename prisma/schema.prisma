generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  BIRTHDAY
  ANNIVERSARY
  MEME
  FANDOM
  HISTORY
  BRAND
}

enum EventCategory {
  CELEBRITY
  INFLUENCER
  KPOP
  ESPORTS
  GAME
  ANIME
  MEME
  BRAND
  HISTORY
  ETC
}

enum TrustLevel {
  OFFICIAL
  SOURCE_VERIFIED
  COMMUNITY
  UNCERTAIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum SourceType {
  OFFICIAL
  NEWS
  WIKI
  COMMUNITY
  SNS
}

enum SubmissionType {
  NEW_EVENT
  EDIT_REQUEST
  SOURCE_ADD
  REPORT
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  NEED_MORE
}

enum AdInquiryStatus {
  PENDING
  CONTACTED
  CLOSED
}

model Event {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  month       Int
  day         Int
  year        Int?
  type        EventType
  category    EventCategory
  description String
  contentIdea String?
  trustLevel  TrustLevel    @default(UNCERTAIN)
  status      EventStatus   @default(PUBLISHED)

  sources     Source[]
  tags        EventTag[]
  oneLines    OneLine[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([month, day])
  @@index([type])
  @@index([category])
  @@index([status])
}

model Source {
  id        String     @id @default(cuid())
  eventId   String
  title     String
  url       String
  type      SourceType
  verified  Boolean    @default(false)

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([eventId])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique

  events    EventTag[]

  createdAt DateTime   @default(now())
}

model EventTag {
  eventId String
  tagId   String

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
}

model OneLine {
  id        String    @id @default(cuid())
  eventId   String
  nickname  String?
  body      String
  ipHash    String?
  userAgent String?
  deletedAt DateTime?

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([eventId])
  @@index([ipHash])
  @@index([createdAt])
  @@index([deletedAt])
}

model Submission {
  id             String           @id @default(cuid())
  type           SubmissionType
  status         SubmissionStatus @default(PENDING)

  title          String
  month          Int?
  day            Int?
  category       String?
  sourceUrl      String?
  description    String
  submitterEmail String?
  adminNote      String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model AdInquiry {
  id         String          @id @default(cuid())
  status     AdInquiryStatus @default(PENDING)

  email      String
  targetPage String?
  message    String

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
}